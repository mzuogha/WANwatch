[Unit]
Description=WANWatch - FortiGate WAN health and SLA monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wanwatch
Group=wanwatch
WorkingDirectory=/opt/wanwatch
ExecStart=/opt/wanwatch/venv/bin/python -m wanwatch run -c /opt/wanwatch/config.yaml
Restart=always
RestartSec=5
TimeoutStopSec=20
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wanwatch/data /opt/wanwatch/logs /opt/wanwatch/reports
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
# to bind port 443 directly instead of 8080, uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
